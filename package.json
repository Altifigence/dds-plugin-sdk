{
  "name": "@altifigence/dds-plugin-sdk",
  "version": "0.1.0",
  "description": "Portable plugin contracts and a local developer host for Digital Design Studio",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22 <23 || >=24 <25" },
  "repository": { "type": "git", "url": "https://github.com/Altifigence/dds-plugin-sdk.git" },
  "homepage": "https://github.com/Altifigence/dds-plugin-sdk#readme",
  "bugs": { "url": "https://github.com/Altifigence/dds-plugin-sdk/issues" },
  "exports": {
    ".": { "types": "./src/index.d.mts", "import": "./src/index.mjs" },
    "./testing": { "types": "./src/testing.d.mts", "import": "./src/testing.mjs" },
    "./schemas": { "types": "./src/schemas.d.mts", "import": "./src/schemas.mjs" },
    "./package.json": "./package.json"
  },
  "files": ["src/", "schemas/", "examples/", "docs/", "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE", "NOTICE"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "schemas:write": "node scripts/schemas.mjs --write",
    "schemas:check": "node scripts/schemas.mjs --check",
    "example": "node examples/hello-diagnostics/run.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "npm run schemas:check && npm test && npm run test:types && npm run example && npm run pack:check"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
