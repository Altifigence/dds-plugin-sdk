{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.13.0/schemas/formatting-options.schema.json",
  "title": "formatting-options",
  "type": "object",
  "properties": {
    "tabSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "insertSpaces": {
      "type": "boolean"
    },
    "trimTrailingWhitespace": {
      "type": "boolean"
    },
    "insertFinalNewline": {
      "type": "boolean"
    },
    "trimFinalNewlines": {
      "type": "boolean"
    },
    "endOfLine": {
      "enum": [
        "preserve",
        "lf",
        "crlf"
      ]
    }
  },
  "required": [
    "tabSize",
    "insertSpaces"
  ],
  "additionalProperties": false
}
