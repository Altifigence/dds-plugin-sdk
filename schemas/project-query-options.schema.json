{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0/schemas/project-query-options.schema.json",
  "title": "project-query-options",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "maxLength": 1024,
          "$comment": "Empty root requires explicit operator scope."
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "maxItems": 16,
          "uniqueItems": true,
          "$comment": "Runtime supports *, ?, and whole-segment ** only."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "maxItems": 16,
          "uniqueItems": true,
          "$comment": "Runtime supports *, ?, and whole-segment ** only."
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "maxScanBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "scanTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "kind": {
          "const": "tree"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 16384,
          "maximum": 131072
        },
        "cursor": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}:[1-9][0-9]{0,2}$"
        }
      },
      "required": [
        "kind",
        "root"
      ],
      "additionalProperties": false
    },
