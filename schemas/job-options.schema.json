{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.11.0/schemas/job-options.schema.json",
  "title": "job-options",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800000
    }
  },
  "required": [
    "jobId"
  ],
  "additionalProperties": false
}
