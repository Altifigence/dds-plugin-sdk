{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0-rc.1/schemas/test-trace.schema.json",
  "title": "test-trace",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "fixtureVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fixtureDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fixtureId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "operation": {
            "enum": [
              "command",
              "language",
              "workspace",
              "project",
              "job",
              "binary",
              "settings",
              "secret",
              "backend"
            ]
          },
          "inputSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outputSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "previousSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "sequence",
          "at",
          "fixtureId",
          "operation",
          "inputSha256",
          "outputSha256",
          "previousSha256",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 1024
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "seed",
    "fixtureVersion",
    "fixtureDigest",
    "events",
    "digest"
  ],
  "additionalProperties": false
}
