{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.1.0/schemas/bundle-dependency.schema.json",
  "title": "bundle-dependency",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "type": {
      "enum": [
        "module",
        "commonjs"
      ]
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "licenseFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "noticeFile": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        {
          "type": "null"
        }
      ]
    },
    "redistributable": {
      "const": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "data": {
            "type": "string",
            "maxLength": 5592408
          }
        },
        "required": [
          "path",
          "data"
        ],
        "additionalProperties": false
      },
      "maxItems": 1024
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "name",
    "version",
    "source",
    "entry",
    "type",
    "dependencies",
    "license",
    "licenseFile",
    "noticeFile",
    "redistributable",
    "files",
    "sha256"
  ],
  "additionalProperties": false
}
