{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.2.0/schemas/artifact-sink-capabilities.schema.json",
  "title": "artifact-sink-capabilities",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "caller",
        "file-system-access",
        "opfs"
      ]
    },
    "seek": {
      "type": "boolean"
    },
    "readback": {
      "type": "boolean"
    },
    "persistence": {
      "enum": [
        "none",
        "on-commit",
        "per-checkpoint"
      ]
    },
    "abort": {
      "enum": [
        "discard",
        "retain",
        "unknown"
      ]
    }
  },
  "required": [
    "kind",
    "seek",
    "readback",
    "persistence",
    "abort"
  ],
  "additionalProperties": false
}
