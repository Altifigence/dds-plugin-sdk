{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.11.0/schemas/language-capabilities.schema.json",
  "title": "language-capabilities",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "features": {
      "const": [
        "completion",
        "hover",
        "definition",
        "references",
        "document-symbols",
        "signature-help"
      ]
    },
    "completionResolve": {
      "const": true
    },
    "snippets": {
      "const": true
    },
    "positions": {
      "const": "utf16-zero-based"
    },
    "limits": {
      "type": "object",
      "properties": {
        "signatures": {
          "const": 16
        },
        "parameters": {
          "const": 64
        },
        "signatureLabel": {
          "const": 2048
        },
        "documentation": {
          "const": 16384
        },
        "snippetChars": {
          "const": 16384
        },
        "snippetStops": {
          "const": 128
        },
        "additionalEdits": {
          "const": 32
        },
        "resolveDataBytes": {
          "const": 4096
        },
        "resolveTokens": {
          "const": 128
        },
        "resolveBytes": {
          "const": 4194304
        },
        "resolveTtlMs": {
          "const": 60000
        },
        "resolvePending": {
          "const": 4
        }
      },
      "required": [
        "signatures",
        "parameters",
        "signatureLabel",
        "documentation",
        "snippetChars",
        "snippetStops",
        "additionalEdits",
        "resolveDataBytes",
        "resolveTokens",
        "resolveBytes",
        "resolveTtlMs",
        "resolvePending"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "features",
    "completionResolve",
    "snippets",
    "positions",
    "limits"
  ],
  "additionalProperties": false
}
