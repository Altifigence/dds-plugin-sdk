{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.1.0/schemas/upstream-candidate.schema.json",
  "title": "upstream-candidate",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "current": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "url",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "observedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "manifest": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "api": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 4096,
              "uniqueItems": true
            },
            "license": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 131072
                },
                "notice": {
                  "type": "string",
                  "maxLength": 131072
                },
                "redistributable": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "text",
                "notice",
                "redistributable"
              ],
              "additionalProperties": false
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "maxItems": 4096
            }
          },
          "required": [
            "schemaVersion",
            "name",
            "version",
            "revision",
            "api",
            "license",
            "files"
          ],
          "additionalProperties": false
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "source",
        "observedAt",
        "manifest",
        "manifestSha256"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "url",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "observedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "manifest": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "api": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 4096,
              "uniqueItems": true
            },
            "license": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 131072
                },
                "notice": {
                  "type": "string",
                  "maxLength": 131072
                },
                "redistributable": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "text",
                "notice",
                "redistributable"
              ],
              "additionalProperties": false
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "maxItems": 4096
            }
          },
          "required": [
            "schemaVersion",
            "name",
            "version",
            "revision",
            "api",
            "license",
            "files"
          ],
          "additionalProperties": false
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "source",
        "observedAt",
        "manifest",
        "manifestSha256"
      ],
      "additionalProperties": false
    },
    "tagChanged": {
      "type": "boolean"
    },
    "api": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 4096
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 4096
        },
        "missingRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 4096
        }
      },
      "required": [
        "added",
        "removed",
        "missingRequired"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "maxItems": 4096
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "maxItems": 4096
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "maxItems": 4096
        }
      },
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "additionalProperties": false
    },
    "licenseChanged": {
      "type": "boolean"
    },
    "redistributable": {
      "type": "boolean"
    },
    "compatibility": {
      "enum": [
        "supported",
        "unsupported",
        "unverified"
      ]
    },
    "functional": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "passed",
            "failed",
            "unverified"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "state",
        "detail"
      ],
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "properties": {
        "expectedSourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "replacementSource": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "url",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "expectedSourceSha256",
        "replacementSource"
      ],
      "additionalProperties": false
    },
    "reviewRequired": {
      "const": true
    },
    "automaticActions": {
      "type": "array",
      "maxItems": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "current",
    "candidate",
    "tagChanged",
    "api",
    "files",
    "licenseChanged",
    "redistributable",
    "compatibility",
    "functional",
    "patch",
    "reviewRequired",
    "automaticActions",
    "sha256"
  ],
  "additionalProperties": false
}
