{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.1.0/schemas/workspace-project-capabilities.schema.json",
  "title": "workspace-project-capabilities",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "projectId",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "watch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "supported": {
              "const": true
            },
            "platform": {
              "enum": [
                "win32",
                "linux"
              ]
            },
            "fileSystem": {
              "const": "local"
            },
            "filesystemType": {
              "type": "string",
              "pattern": "^\\d{1,20}$"
            },
            "mode": {
              "const": "native-hints-with-reconciliation"
            },
            "rename": {
              "const": "delete-create"
            },
            "roots": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1024,
                "$comment": "Empty root requires explicit operator scope."
              },
              "maxItems": 16,
              "minItems": 1,
              "uniqueItems": true
            },
            "limits": {
              "type": "object",
              "properties": {
                "observers": {
                  "const": 4
                },
                "nativeHandles": {
                  "const": 128
                },
                "entries": {
                  "const": 1000
                },
                "visited": {
                  "const": 10000
                },
                "depth": {
                  "const": 32
                },
                "patterns": {
                  "const": 16
                },
                "patternLength": {
                  "const": 256
                },
                "fileBytes": {
                  "const": 16777216
                },
                "scanBytes": {
                  "const": 67108864
                },
                "snapshotBytes": {
                  "const": 131072
                },
                "changes": {
                  "const": 256
                },
                "queue": {
                  "const": 4
                },
                "minIntervalMs": {
                  "const": 250
                },
                "maxIntervalMs": {
                  "const": 60000
                },
                "defaultIntervalMs": {
                  "const": 1000
                },
                "minDebounceMs": {
                  "const": 10
                },
                "maxDebounceMs": {
                  "const": 1000
                },
                "defaultDebounceMs": {
                  "const": 50
                },
                "maxScanMs": {
                  "const": 30000
                }
              },
              "required": [
                "observers",
                "nativeHandles",
                "entries",
                "visited",
                "depth",
                "patterns",
                "patternLength",
                "fileBytes",
                "scanBytes",
                "snapshotBytes",
                "changes",
                "queue",
                "minIntervalMs",
                "maxIntervalMs",
                "defaultIntervalMs",
                "minDebounceMs",
                "maxDebounceMs",
                "defaultDebounceMs",
                "maxScanMs"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "supported",
            "platform",
            "fileSystem",
            "filesystemType",
            "mode",
            "rename",
            "roots",
            "limits"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "supported": {
              "const": true
            },
            "kinds": {
              "const": [
                "tree",
                "files",
                "text"
              ]
            },
            "caseFolding": {
              "const": "ascii"
            },
            "ranges": {
              "const": "utf16-zero-based"
            },
            "cursor": {
              "const": "query-bound-frozen-membership"
            },
            "roots": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1024,
                "$comment": "Empty root requires explicit operator scope."
              },
              "maxItems": 16,
              "minItems": 1,
              "uniqueItems": true
            },
            "limits": {
              "type": "object",
              "properties": {
                "concurrent": {
                  "const": 2
                },
                "views": {
                  "const": 8
                },
                "cursorTtlMs": {
                  "const": 60000
                },
                "pageSize": {
                  "const": 64
                },
                "results": {
                  "const": 512
                },
                "queryChars": {
                  "const": 256
                },
                "snippetChars": {
                  "const": 512
                },
                "textFileBytes": {
                  "const": 262144
                },
                "responseBytes": {
                  "const": 131072
                },
                "minResponseBytes": {
                  "const": 16384
                },
                "viewBytes": {
                  "const": 262144
                }
              },
              "required": [
                "concurrent",
                "views",
                "cursorTtlMs",
                "pageSize",
                "results",
                "queryChars",
                "snippetChars",
                "textFileBytes",
                "responseBytes",
                "minResponseBytes",
                "viewBytes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "supported",
            "kinds",
            "caseFolding",
            "ranges",
            "cursor",
            "roots",
            "limits"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "subscriptions": {
          "const": 4
        },
        "leaseMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 30000
        },
        "minLeaseMs": {
          "const": 250
        },
        "maxPollMs": {
          "const": 1000
        },
        "maxWatchMs": {
          "const": 1800000
        }
      },
      "required": [
        "subscriptions",
        "leaseMs",
        "minLeaseMs",
        "maxPollMs",
        "maxWatchMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "enabled",
    "scope",
    "watch",
    "query",
    "limits"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "watch": {
            "type": "null"
          },
          "query": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "watch": {
            "type": "object"
          },
          "query": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$comment": "Runtime requires equal explicit root scopes for watch and query ports."
}
