{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.2.0/schemas/provenance-receipt.schema.json",
  "title": "provenance-receipt",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "subject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "checksum": {
      "type": "boolean"
    },
    "signature": {
      "enum": [
        "verified",
        "invalid",
        "unsigned",
        "untrusted-key",
        "unsupported"
      ]
    },
    "publisher": {
      "enum": [
        "verified",
        "unverified"
      ]
    },
    "policy": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "keyId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "checkedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "offline": {
      "type": "boolean"
    },
    "revocationsObservedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 32
    },
    "executionAuthorized": {
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "subject",
    "checksum",
    "signature",
    "publisher",
    "policy",
    "keyId",
    "checkedAt",
    "offline",
    "revocationsObservedAt",
    "reasons",
    "executionAuthorized"
  ],
  "additionalProperties": false
}
