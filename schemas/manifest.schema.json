{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.2.0/schemas/manifest.schema.json",
  "title": "manifest",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "protocolVersion": {
      "const": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\./(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\\.mjs$"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "manifestVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "protocolVersion": {
          "const": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\./(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\\.mjs$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "diagnostics"
            ]
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "enum": [
              "document.read",
              "diagnostics.publish"
            ]
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "supportedHosts": {
          "type": "array",
          "items": {
            "enum": [
              "test-host"
            ]
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9.+-]+$"
        }
      },
      "required": [
        "manifestVersion",
        "id",
        "name",
        "publisher",
        "version",
        "protocolVersion",
        "entry",
        "capabilities",
        "permissions",
        "supportedHosts",
        "license"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "manifestVersion": {
          "const": 2
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "protocolVersion": {
          "const": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\./(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\\.mjs$"
        },
        "runtime": {
          "enum": [
            "ui",
            "workspace"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "diagnostics",
              "commands",
              "settings",
              "completion",
              "hover",
              "definition",
              "references",
              "document-symbols",
              "signature-help",
              "prepare-rename",
              "rename",
              "format-document",
              "format-range",
              "code-actions",
              "semantic-tokens",
              "folding-ranges",
              "inlay-hints",
              "document-symbol-tree",
              "completion-resolve",
              "completion-snippets",
              "code-action-resolve",
              "semantic-tokens-delta"
            ]
          },
          "minItems": 1,
          "maxItems": 22,
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "enum": [
              "document.read",
              "diagnostics.publish",
              "workspace.read",
              "workspace.write",
              "backend.invoke",
              "language.provide",
              "settings.read",
              "secrets.resolve"
            ]
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "supportedHosts": {
          "type": "array",
          "items": {
            "enum": [
              "test-host",
              "workspace-host"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9.+:()\\s-]+$",
          "x-licenseExpression": true,
          "$comment": "Runtime validates bounded SPDX-style expression grammar; this is not legal permission."
        },
        "source": {
          "type": "object",
          "properties": {
            "visibility": {
              "enum": [
                "open",
                "closed"
              ]
            },
            "licenseFile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?:\\./)?(?!\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001f\\u007f]+)*$"
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://[^\\s?#]+$",
              "format": "uri",
              "$comment": "Runtime also rejects credentials."
            }
          },
          "required": [
            "visibility",
            "licenseFile"
          ],
          "additionalProperties": false
        },
        "display": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "help": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "order": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "labelKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!constructor$|prototype$|__proto__$)[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "helpKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!constructor$|prototype$|__proto__$)[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "accessibility": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "nameKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^(?!constructor$|prototype$|__proto__$)[A-Za-z][A-Za-z0-9_.-]{0,127}$"
                },
                "descriptionKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^(?!constructor$|prototype$|__proto__$)[A-Za-z][A-Za-z0-9_.-]{0,127}$"
                },
                "shortcut": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "manifestVersion",
        "id",
        "name",
        "publisher",
        "version",
        "protocolVersion",
        "entry",
        "runtime",
        "capabilities",
        "permissions",
        "supportedHosts",
        "license",
        "source"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "ui"
              }
            }
          },
          "then": {
            "properties": {
              "permissions": {
                "items": {
                  "enum": [
                    "document.read",
                    "diagnostics.publish",
                    "language.provide",
                    "settings.read"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "enum": [
                    "completion-resolve",
                    "completion-snippets"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "completion"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "code-action-resolve"
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "code-actions"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "semantic-tokens-delta"
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "semantic-tokens"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
