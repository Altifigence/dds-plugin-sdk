{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.1.0/schemas/manifest.schema.json",
  "title": "manifest",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "protocolVersion": {
      "const": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\./(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\\.mjs$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "diagnostics"
        ]
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "document.read",
          "diagnostics.publish"
        ]
      },
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true
    },
    "supportedHosts": {
      "type": "array",
      "items": {
        "enum": [
          "test-host"
        ]
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9.+-]+$"
    }
  },
  "required": [
    "manifestVersion",
    "id",
    "name",
    "publisher",
    "version",
    "protocolVersion",
    "entry",
    "capabilities",
    "permissions",
    "supportedHosts",
    "license"
  ],
  "additionalProperties": false
}
