{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.9.0/schemas/stored-artifact.schema.json",
  "title": "stored-artifact",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "storeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workspaceIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pluginArtifactSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "text",
        "binary"
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "$comment": "Runtime enforces the protected workspace file policy."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        }
      },
      "required": [
        "id",
        "path",
        "revision",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "capturedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "storeId",
    "workspaceId",
    "workspaceIdentity",
    "snapshotId",
    "jobId",
    "pluginId",
    "pluginArtifactSha256",
    "kind",
    "artifact",
    "capturedAt",
    "expiresAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text"
          }
        }
      },
      "then": {
        "properties": {
          "artifact": {
            "properties": {
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Runtime checks identity, labels are excluded, and capturedAt/expiresAt ordering and maximum retention."
}
