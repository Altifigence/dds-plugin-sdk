{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.10.0/schemas/upload-reference.schema.json",
  "title": "upload-reference",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "projectId",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "storeId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "workspaceIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "protocolVersion",
        "storeId",
        "workspaceId",
        "workspaceIdentity",
        "principalId"
      ],
      "additionalProperties": false
    },
    "uploadGeneration": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "spec": {
      "type": "object",
      "properties": {
        "uploadId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "pluginId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedRevision": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "uploadId",
        "pluginId",
        "artifactSha256",
        "path",
        "byteLength",
        "sha256",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "protocolVersion",
    "scope",
    "identity",
    "uploadGeneration",
    "spec",
    "createdAt",
    "expiresAt"
  ],
  "additionalProperties": false
}
