{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.9.0/schemas/command.schema.json",
  "title": "command",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "enum": [
              "string",
              "number",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "label",
          "type",
          "required"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "choices"
              ]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "string"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 32
    }
  },
  "required": [
    "id",
    "title"
  ],
  "additionalProperties": false
}
