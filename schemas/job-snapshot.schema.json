{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.5.0/schemas/job-snapshot.schema.json",
  "title": "job-snapshot",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "scope": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "projectId",
            "sessionId"
          ],
          "additionalProperties": false
        },
        "pluginId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800000
        },
        "progress": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "completed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "total": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "x-maxUtf8Bytes": 2048
                }
              },
              "required": [
                "completed",
                "total"
              ],
              "additionalProperties": false
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "$comment": "Runtime enforces the protected workspace file policy."
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "id",
              "path",
              "revision",
              "byteLength"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "const": "running"
        }
      },
      "required": [
        "protocolVersion",
        "jobId",
        "scope",
        "pluginId",
        "commandId",
        "startedAt",
        "updatedAt",
        "timeoutMs",
        "progress",
        "artifacts",
        "lastSequence",
        "state"
      ],
      "additionalProperties": false
    },
