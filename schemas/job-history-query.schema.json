{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.13.0/schemas/job-history-query.schema.json",
  "title": "job-history-query",
  "type": "object",
  "properties": {
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "state": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "disposition": {
      "enum": [
        "live",
        "completed",
        "interrupted",
        "expired"
      ]
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "from": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "to": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "attemptOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}:(?:0|[1-9][0-9]{0,2})$"
    }
  },
  "required": [],
  "additionalProperties": false,
  "$comment": "Default limit 16. Runtime checks cursor offset and inclusive time ordering. Cursor binds the normalized filters and current host generation."
}
