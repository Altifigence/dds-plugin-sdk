{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0/schemas/upload-spec.schema.json",
  "title": "upload-spec",
  "type": "object",
  "properties": {
    "uploadId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedRevision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "uploadId",
    "pluginId",
    "artifactSha256",
    "path",
    "byteLength",
    "sha256",
    "expectedRevision"
  ],
  "additionalProperties": false
}
