{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.2.0/schemas/folding-ranges.schema.json",
  "title": "folding-ranges",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "range": {
        "type": "object",
        "properties": {
          "start": {
            "type": "object",
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              },
              "character": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              }
            },
            "required": [
              "line",
              "character"
            ],
            "additionalProperties": false
          },
          "end": {
            "type": "object",
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              },
              "character": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              }
            },
            "required": [
              "line",
              "character"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "kind": {
        "enum": [
          "region",
          "comment",
          "imports"
        ]
      },
      "collapsedText": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "required": [
      "range"
    ],
    "additionalProperties": false
  },
  "maxItems": 1000,
  "minItems": 0,
  "$comment": "Runtime rejects empty, duplicate, crossing or unordered ranges and nesting deeper than 32."
}
