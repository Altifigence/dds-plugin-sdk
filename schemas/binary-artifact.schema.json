{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.11.0/schemas/binary-artifact.schema.json",
  "title": "binary-artifact",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "$comment": "Runtime enforces the protected workspace file policy."
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "id",
    "path",
    "revision",
    "byteLength"
  ],
  "additionalProperties": false
}
