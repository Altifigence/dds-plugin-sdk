{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0-rc.1/schemas/display-metadata.schema.json",
  "title": "display-metadata",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "help": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "labelKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!constructor$|prototype$|__proto__$)[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "helpKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!constructor$|prototype$|__proto__$)[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "nameKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!constructor$|prototype$|__proto__$)[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "descriptionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!constructor$|prototype$|__proto__$)[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "shortcut": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false,
  "$comment": "All fields are literal display data. Runtime additionally checks well-formed UTF-16 and rejects NUL. Locale key cross-checks are separate."
}
