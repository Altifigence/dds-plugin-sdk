{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0-rc.1/schemas/stored-artifact-list.schema.json",
  "title": "stored-artifact-list",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "projectId",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "storeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pluginArtifactSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "disposition": {
      "enum": [
        "live",
        "completed",
        "interrupted",
        "expired",
        "missing",
        "corrupt",
        "unsupported"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "binary"
                ]
              },
              "artifact": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "$comment": "Runtime enforces the protected workspace file policy."
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "byteLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1073741824
                  }
                },
                "required": [
                  "id",
                  "path",
                  "revision",
                  "byteLength"
                ],
                "additionalProperties": false
              },
              "storage": {
                "const": "source"
              },
              "availability": {
                "const": "source-reference"
              },
              "snapshot": {
                "type": "null"
              }
            },
            "required": [
              "kind",
              "artifact",
              "storage",
              "availability",
              "snapshot"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "binary"
                ]
              },
              "artifact": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "$comment": "Runtime enforces the protected workspace file policy."
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "byteLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1073741824
                  }
                },
                "required": [
                  "id",
                  "path",
                  "revision",
                  "byteLength"
                ],
                "additionalProperties": false
              },
              "storage": {
                "const": "snapshot"
              },
              "availability": {
                "enum": [
                  "retained",
                  "expired",
                  "missing",
                  "corrupt",
                  "unsupported"
                ]
              },
              "snapshot": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "const": 1
                  },
                  "storeId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 36,
                    "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                  },
                  "workspaceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "workspaceIdentity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "snapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 36,
                    "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                  },
                  "jobId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 36,
                    "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                  },
                  "pluginId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "pluginArtifactSha256": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "kind": {
                    "enum": [
                      "text",
                      "binary"
                    ]
                  },
                  "artifact": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "$comment": "Runtime enforces the protected workspace file policy."
                      },
                      "revision": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "byteLength": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1073741824
                      }
                    },
                    "required": [
                      "id",
                      "path",
                      "revision",
                      "byteLength"
                    ],
                    "additionalProperties": false
                  },
                  "capturedAt": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "expiresAt": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "schemaVersion",
                  "storeId",
                  "workspaceId",
                  "workspaceIdentity",
                  "snapshotId",
                  "jobId",
                  "pluginId",
                  "pluginArtifactSha256",
                  "kind",
                  "artifact",
                  "capturedAt",
                  "expiresAt"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "text"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "artifact": {
                          "properties": {
                            "byteLength": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 262144
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "kind",
              "artifact",
              "storage",
              "availability",
              "snapshot"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "protocolVersion",
    "scope",
    "storeId",
    "jobId",
    "pluginId",
    "pluginArtifactSha256",
    "disposition",
    "artifacts"
  ],
  "additionalProperties": false,
  "$comment": "Runtime enforces unique artifact IDs, matching embedded snapshot bindings and empty artifacts for unavailable jobs. Retained describes indexed metadata; get performs byte verification."
}
