{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.12.0/schemas/job-events.schema.json",
  "title": "job-events",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "projectId",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nextCursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dropped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hasMore": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "const": "progress"
              },
              "data": {
                "type": "object",
                "properties": {
                  "completed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "x-maxUtf8Bytes": 2048
                  }
                },
                "required": [
                  "completed",
                  "total"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sequence",
              "at",
              "kind",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "const": "artifact"
              },
              "data": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "$comment": "Runtime enforces the protected workspace file policy."
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "byteLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 262144
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "id",
                  "path",
                  "revision",
                  "byteLength"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sequence",
              "at",
              "kind",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "const": "state"
              },
              "data": {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "running",
                      "succeeded",
                      "failed",
                      "cancelled",
                      "timed_out"
                    ]
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sequence",
              "at",
              "kind",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "const": "log"
              },
              "data": {
                "type": "object",
                "properties": {
                  "level": {
                    "enum": [
                      "debug",
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "x-maxUtf8Bytes": 2048
                  }
                },
                "required": [
                  "level",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sequence",
              "at",
              "kind",
              "data"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "jobId",
    "scope",
    "after",
    "nextCursor",
    "dropped",
    "hasMore",
    "events"
  ],
  "additionalProperties": false
}
