{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0/schemas/generation-report.schema.json",
  "title": "generation-report",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previousDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "current": {
      "type": "boolean"
    },
    "written": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 1
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "directory",
    "sdkVersion",
    "digest",
    "previousDigest",
    "current",
    "written",
    "files",
    "conflicts"
  ],
  "additionalProperties": false
}
