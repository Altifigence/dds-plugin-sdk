{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.10.0/schemas/project-watch-options.schema.json",
  "title": "project-watch-options",
  "type": "object",
  "properties": {
    "root": {
      "type": "string",
      "maxLength": 1024,
      "$comment": "Empty root requires explicit operator scope."
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256,
        "minLength": 1
      },
      "maxItems": 16,
      "uniqueItems": true,
      "$comment": "Runtime supports *, ?, and whole-segment ** only."
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256,
        "minLength": 1
      },
      "maxItems": 16,
      "uniqueItems": true,
      "$comment": "Runtime supports *, ?, and whole-segment ** only."
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "maxEntries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maxFileBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "maxScanBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "scanTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "intervalMs": {
      "type": "integer",
      "minimum": 250,
      "maximum": 60000
    },
    "debounceMs": {
      "type": "integer",
      "minimum": 10,
      "maximum": 1000
    }
  },
  "required": [
    "root"
  ],
  "additionalProperties": false,
  "$comment": "Runtime applies defaults, rejects unknown fields, and intersects root with operator-configured roots."
}
