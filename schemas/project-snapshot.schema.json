{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0-rc.1/schemas/project-snapshot.schema.json",
  "title": "project-snapshot",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "maxLength": 1024,
      "$comment": "Empty root requires explicit operator scope."
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "$comment": "Runtime applies workspace-relative protected-path and Windows-component rules."
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "revision": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "kind",
          "size",
          "revision",
          "fingerprint"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "directory"
                }
              }
            },
            "then": {
              "properties": {
                "size": {
                  "const": 0
                },
                "revision": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "$comment": "For hashed files fingerprint equals the content revision. Otherwise it is opaque metadata, not a content checksum."
      },
      "maxItems": 1000
    },
    "complete": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "enum": [
          "entry_limit",
          "visit_limit",
          "depth_limit",
          "file_bytes",
          "scan_bytes",
          "snapshot_bytes",
          "scan_timeout",
          "unsafe_entries",
          "unstable"
        ]
      },
      "maxItems": 9,
      "uniqueItems": true
    },
    "observedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "root",
    "revision",
    "entries",
    "complete",
    "reasons",
    "observedAt"
  ],
  "additionalProperties": false,
  "x-maxUtf8Bytes": 131072,
  "$comment": "Runtime checks sorted unique scoped paths and complete iff reasons is empty. This is a bounded per-file validated view, not a filesystem transaction.",
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reasons": {
            "maxItems": 0
          },
          "entries": {
            "items": {
              "if": {
                "properties": {
                  "kind": {
                    "const": "file"
                  }
                }
              },
              "then": {
                "properties": {
                  "revision": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
