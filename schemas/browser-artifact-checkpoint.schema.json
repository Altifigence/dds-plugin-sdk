{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.10.0/schemas/browser-artifact-checkpoint.schema.json",
  "title": "browser-artifact-checkpoint",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "partialId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "storeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workspaceIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "pluginId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pluginArtifactSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "text",
            "binary"
          ]
        },
        "artifact": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "$comment": "Runtime enforces the protected workspace file policy."
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1073741824
            }
          },
          "required": [
            "id",
            "path",
            "revision",
            "byteLength"
          ],
          "additionalProperties": false
        },
        "capturedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "storeId",
        "workspaceId",
        "workspaceIdentity",
        "snapshotId",
        "jobId",
        "pluginId",
        "pluginArtifactSha256",
        "kind",
        "artifact",
        "capturedAt",
        "expiresAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {
              "artifact": {
                "properties": {
                  "byteLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 262144
                  }
                }
              }
            }
          }
        }
      ]
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "offset",
        "sha256"
      ],
      "additionalProperties": false
    },
    "previousCheckpoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1073741824
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "offset",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "checksum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "partialId",
    "snapshot",
    "createdAt",
    "updatedAt",
    "expiresAt",
    "state",
    "checkpoint",
    "previousCheckpoint",
    "checksum"
  ],
  "additionalProperties": false,
  "x-maxUtf8Bytes": 16384,
  "$comment": "Runtime checks canonical JSON SHA-256 excluding checksum, full stored identity, checkpoint offsets and empty prefix SHA, previous offset ordering, completed full hash, and retention <=24h capped by the stored artifact expiry. No token, grants or old connection scope are stored."
}
