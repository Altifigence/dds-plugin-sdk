{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.1.0/schemas/signature-help.schema.json",
  "title": "signature-help",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "properties": {
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2048
                      },
                      "minItems": 2,
                      "maxItems": 2,
                      "$comment": "Ordered nonempty UTF-16 label offsets within the signature, without split Unicode characters."
                    },
                    "documentation": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 16384
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 64
              },
              "documentation": {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384
              }
            },
            "required": [
              "label",
              "parameters"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "activeSignature": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "activeParameter": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "signatures",
        "activeSignature",
        "activeParameter"
      ],
      "additionalProperties": false
    }
  ],
  "$comment": "Runtime additionally checks active indices; activeParameter is null only for the selected signature with no parameters."
}
