{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0/schemas/diagnostics-request.schema.json",
  "title": "diagnostics-request",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "projectId",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "languageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "modelVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workspaceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 262144,
          "x-maxUtf8Bytes": 262144
        }
      },
      "required": [
        "uri",
        "languageId",
        "modelVersion",
        "workspaceRevision",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "requestId",
    "scope",
    "snapshot"
  ],
  "additionalProperties": false
}
