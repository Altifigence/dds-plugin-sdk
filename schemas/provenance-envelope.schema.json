{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.2.0/schemas/provenance-envelope.schema.json",
  "title": "provenance-envelope",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "subject": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "name",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "url",
            "revision"
          ],
          "additionalProperties": false
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "subject",
        "publisher",
        "source",
        "issuedAt",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "keyId",
    "payload",
    "signature"
  ],
  "additionalProperties": false,
  "$comment": "Runtime verifies canonical base64 and Ed25519 over DDS-PROVENANCE-V1 plus canonical statement JSON. Trust keys are operator-owned Node KeyObjects; keys are not taken from this envelope."
}
