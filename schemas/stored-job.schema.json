{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0-rc.1/schemas/stored-job.schema.json",
  "title": "stored-job",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "storeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workspaceIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "pluginArtifactSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "savedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "settled": {
      "type": "boolean"
    },
    "contentPolicy": {
      "enum": [
        "metadata-only",
        "host-redacted"
      ]
    },
    "grants": {
      "type": "array",
      "items": {
        "enum": [
          "document.read",
          "diagnostics.publish",
          "workspace.read",
          "workspace.write",
          "backend.invoke",
          "language.provide",
          "settings.read",
          "secrets.resolve"
        ]
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    },
    "snapshot": {
      "$ref": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.0.0-rc.1/schemas/job-snapshot.schema.json"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "const": "progress"
              },
              "data": {
                "type": "object",
                "properties": {
                  "completed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "x-maxUtf8Bytes": 2048
                  }
                },
                "required": [
                  "completed",
                  "total"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sequence",
              "at",
              "kind",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "const": "artifact"
              },
              "data": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "$comment": "Runtime enforces the protected workspace file policy."
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "byteLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 262144
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "id",
                  "path",
                  "revision",
                  "byteLength"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sequence",
              "at",
              "kind",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "const": "state"
              },
              "data": {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "running",
                      "succeeded",
                      "failed",
                      "cancelled",
                      "timed_out"
                    ]
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sequence",
              "at",
              "kind",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "const": "log"
              },
              "data": {
                "type": "object",
                "properties": {
                  "level": {
                    "enum": [
                      "debug",
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "x-maxUtf8Bytes": 2048
                  }
                },
                "required": [
                  "level",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sequence",
              "at",
              "kind",
              "data"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "binaryArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "$comment": "Runtime enforces the protected workspace file policy."
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "path",
          "revision",
          "byteLength"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "attemptOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "retainedArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "storeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "workspaceIdentity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "snapshotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "pluginId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "pluginArtifactSha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "text",
              "binary"
            ]
          },
          "artifact": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "$comment": "Runtime enforces the protected workspace file policy."
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1073741824
              }
            },
            "required": [
              "id",
              "path",
              "revision",
              "byteLength"
            ],
            "additionalProperties": false
          },
          "capturedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "schemaVersion",
          "storeId",
          "workspaceId",
          "workspaceIdentity",
          "snapshotId",
          "jobId",
          "pluginId",
          "pluginArtifactSha256",
          "kind",
          "artifact",
          "capturedAt",
          "expiresAt"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "text"
                }
              }
            },
            "then": {
              "properties": {
                "artifact": {
                  "properties": {
                    "byteLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 262144
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "schemaVersion",
    "storeId",
    "workspaceId",
    "workspaceIdentity",
    "pluginArtifactSha256",
    "requestSha256",
    "revision",
    "savedAt",
    "expiresAt",
    "settled",
    "contentPolicy",
    "grants",
    "snapshot",
    "events",
    "binaryArtifacts"
  ],
  "additionalProperties": false,
  "x-maxUtf8Bytes": 524288,
  "$comment": "Runtime additionally enforces scope and identity, chronological contiguous events, shared artifact IDs, retention bounds, immutable metadata-only redaction and matching terminal state. Retained snapshot references bind exact registered artifacts and this job/workspace/plugin."
}
