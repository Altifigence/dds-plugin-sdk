{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v0.12.0/schemas/workspace-file-revision.schema.json",
  "title": "workspace-file-revision",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "$comment": "Runtime enforces the protected relative workspace path policy."
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "path",
    "revision"
  ],
  "additionalProperties": false
}
