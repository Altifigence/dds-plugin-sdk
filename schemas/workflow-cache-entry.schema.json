{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.2.0/schemas/workflow-cache-entry.schema.json",
  "title": "workflow-cache-entry",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "securityScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        }
      },
      "required": [
        "workspaceId",
        "securityScope"
      ],
      "additionalProperties": false
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "value": {
      "$ref": "https://github.com/Altifigence/dds-plugin-sdk/blob/v1.2.0/schemas/json-value.schema.json"
    },
    "valueSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accessedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    }
  },
  "required": [
    "schemaVersion",
    "key",
    "scope",
    "grants",
    "value",
    "valueSha256",
    "createdAt",
    "expiresAt",
    "accessedAt",
    "byteLength"
  ],
  "additionalProperties": false,
  "x-maxUtf8Bytes": 131072,
  "$comment": "Runtime verifies canonical value digest/UTF-8 length, TTL ordering and rejects secret-reference values. Every cache use rechecks current host authorization."
}
